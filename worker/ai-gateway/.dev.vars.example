# 复制为同目录下的 .dev.vars 后填入真实值（.dev.vars 不入库）
#   copy .dev.vars.example .dev.vars
#
# 取值说明：
#   MOONSHOT_API_KEY     — 月之暗面新建的 key（仓库里曾经硬编码的旧 key 已在控制台作废，勿再用）
#   SUPABASE_ANON_KEY    — Dashboard → API → anon public（或 publishable）；网关用来问「这人登没登」
#   SUPABASE_JWT_SECRET  — 仅当未配 ANON_KEY 时的退路；JWT Keys 里的 secret
#   ADMIN_TOKEN          — 自拟长随机串，用于 POST /admin/entitlement

MOONSHOT_API_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
ADMIN_TOKEN=

# 爱发电 webhook（本地测：POST /webhooks/afdian?k=下面这个值）
AFDIAN_WEBHOOK_TOKEN=
# 与爱发电方案 id、前端 VITE_AFDIAN_SYNC_PLAN_* 一致（也可只放 wrangler [vars]）
AFDIAN_SYNC_PLAN_MONTH=
AFDIAN_SYNC_PLAN_YEAR=
# 打赏等忽略的 plan_id，逗号分隔
# AFDIAN_TIP_PLAN_IDS=

# 可选：试用月额度（默认 20；测 402 时可临时改成 1）
# FREE_MONTHLY_QUOTA=20

# 模型不在此配置：Worker 代码写死 moonshot-v1-8k，不接受客户端改 model
